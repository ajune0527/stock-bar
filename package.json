{
    "name": "stock-bar",
    "displayName": "Stock Bar",
    "description": "股票监控，底部状态栏实时更新 A股|港股|美股|实时股票数据",
    "version": "1.0.12",
    "publisher": "Chef",
    "license": "MIT",
    "keywords": [
        "stock",
        "vscode"
    ],
    "icon": "stocks.png",
    "engines": {
        "vscode": "^1.28.0",
        "node": "^25.5.0"
    },
    "categories": [
        "Other"
    ],
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "publish": "vsce publish ",
        "package:local": "vsce package ",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "activationEvents": [
        "*"
    ],
    "main": "./dist/extension",
    "contributes": {
        "configuration": {
            "properties": {
                "stock-bar.stocks": {
                    "type": "array",
                    "default": [
                        {
                            "code": "000001",
                            "market": "1"
                        },
                        {
                            "code": "399001",
                            "market": "0"
                        }
                    ],
                    "description": "股票代码数组，格式: [{\"code\":\"300308\",\"market\":\"1\"}]，market: 1=沪市, 0=深市"
                },
                "stock-bar.updateInterval": {
                    "type": "number",
                    "default": 10000,
                    "description": "更新数据时间间隔，单位：毫秒"
                },
                "stock-bar.riseColor": {
                    "type": "string",
                    "default": "",
                    "description": "股票涨的颜色，默认跟随系统"
                },
                "stock-bar.fallColor": {
                    "type": "string",
                    "default": "",
                    "description": "股票跌的颜色，默认跟随系统"
                }
            }
        },
        "commands": [
            {
                "command": "stockbar.start",
                "title": "Show Stock Bar",
                "category": "Stock Bar",
                "icon": "$(play)"
            },
            {
                "command": "stockbar.stop",
                "title": "Hide Stock Bar",
                "category": "Stock Bar",
                "icon": "$(debug-stop)"
            },
            {
                "command": "stockbar.add",
                "title": "Add Stock",
                "category": "Stock Bar",
                "icon": "$(add)"
            },
            {
                "command": "stockbar.list",
                "title": "Show Stock List",
                "category": "Stock Bar",
                "icon": "$(list)"
            },
            {
                "command": "stockbar.webview",
                "title": "Open Stock Detail",
                "category": "Stock Bar",
                "icon": "$(preview)"
            },
            {
                "command": "stockbar.refresh",
                "title": "Refresh Data",
                "category": "Stock Bar",
                "icon": "$(refresh)"
            },
            {
                "command": "stockbar.treeItem.remove",
                "title": "Remove Stock",
                "category": "Stock Bar",
                "icon": "$(trash)"
            },
            {
                "command": "stockbar.treeItem.add",
                "title": "Add to Watchlist",
                "category": "Stock Bar",
                "icon": "$(add)"
            },
            {
                "command": "stockbar.treeItem.moveUp",
                "title": "上移",
                "category": "Stock Bar",
                "icon": "$(arrow-up)"
            },
            {
                "command": "stockbar.treeItem.moveDown",
                "title": "下移",
                "category": "Stock Bar",
                "icon": "$(arrow-down)"
            },
            {
                "command": "stockbar.treeItem.moveTop",
                "title": "置顶",
                "category": "Stock Bar",
                "icon": "$(arrow-up)"
            },
            {
                "command": "stockbar.treeItem.moveBottom",
                "title": "置底",
                "category": "Stock Bar",
                "icon": "$(arrow-down)"
            }
        ],
        "keybindings": [
            {
                "command": "stockbar.list",
                "key": "ctrl+shift+s",
                "mac": "cmd+shift+s"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "stockBar",
                    "title": "Stock Bar",
                    "icon": "$(graph)"
                }
            ]
        },
        "views": {
            "stockBar": [
                {
                    "id": "stockBarList",
                    "name": "自选股",
                    "icon": "$(list)",
                    "contextualTitle": "Stock Bar - 自选股列表"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "stockbar.refresh",
                    "when": "view == stockBarList",
                    "group": "navigation@1"
                },
                {
                    "command": "stockbar.add",
                    "when": "view == stockBarList",
                    "group": "navigation@2"
                },
                {
                    "command": "stockbar.webview",
                    "when": "view == stockBarList",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "stockbar.treeItem.moveUp",
                    "when": "view == stockBarList && viewItem == stock",
                    "group": "1_sort@1"
                },
                {
                    "command": "stockbar.treeItem.moveDown",
                    "when": "view == stockBarList && viewItem == stock",
                    "group": "1_sort@2"
                },
                {
                    "command": "stockbar.treeItem.moveTop",
                    "when": "view == stockBarList && viewItem == stock",
                    "group": "1_sort@3"
                },
                {
                    "command": "stockbar.treeItem.moveBottom",
                    "when": "view == stockBarList && viewItem == stock",
                    "group": "1_sort@4"
                },
                {
                    "command": "stockbar.treeItem.remove",
                    "when": "view == stockBarList && viewItem == stock",
                    "group": "2_danger@1"
                },
                {
                    "command": "stockbar.treeItem.add",
                    "when": "view == stockBarList && viewItem == searchResult",
                    "group": "inline@1"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/glob": "^7.2.0",
        "@types/mocha": "^9.1.1",
        "@types/node": "^25.0.0",
        "@types/vscode": "^1.28.0",
        "@typescript-eslint/eslint-plugin": "^5.27.0",
        "@typescript-eslint/parser": "^5.27.1",
        "@vscode/test-electron": "^2.1.3",
        "eslint": "^8.17.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "glob": "^8.0.3",
        "mocha": "^10.0.0",
        "prettier": "^2.6.2",
        "ts-loader": "^9.3.0",
        "typescript": "^4.7.2",
        "webpack": "^5.76.0",
        "webpack-cli": "^4.10.0"
    },
    "dependencies": {
        "axios": "^0.27.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Chef5/stock-bar"
    }
}
